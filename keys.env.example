# Copy this file to keys.env and put your own keys in. keys.env stays on
# your machine and git ignores it. No quotes, no spaces around the equals.

# Chapter 3: a free Alpaca practice account and a free Massive key.
APCA_API_KEY_ID=your-alpaca-key-id
APCA_API_SECRET_KEY=your-alpaca-secret
MASSIVE_API_KEY=your-massive-key

# Chapter 4: one model provider is enough. Keep the line you use.
OPENAI_API_KEY=your-key
ANTHROPIC_API_KEY=your-key

# Chapter 10: your live Alpaca keys, for the day `python ladder.py` says
# EARNED on your own record. Leave both lines commented out until then.
# APCA_LIVE_API_KEY_ID=your-live-key-id
# APCA_LIVE_API_SECRET_KEY=your-live-secret
